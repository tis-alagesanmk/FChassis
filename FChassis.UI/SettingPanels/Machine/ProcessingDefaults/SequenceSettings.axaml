<base:Panel xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" 
			 Background="White"
			 xmlns:base="FChassis.UI.Settings"
			 xmlns:vm="using:FChassis.Data.ViewModels.Setting.Machine.ProcessingDefaults"
			 x:DataType="vm:SequenceViewModel"
             x:Class="FChassis.UI.Settings.Machine.ProcessingDefaults.SequenceSettings">
	<UserControl.DataContext>
		<vm:SequenceViewModel/>
	</UserControl.DataContext>
</base:Panel>
