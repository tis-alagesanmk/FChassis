<base:Panel
	    xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
		d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FChassis.UI.Settings.Laser.LaserCutting.Cutting.TabPanel"
		xmlns:base="FChassis.UI.Settings"
		>
	<Grid x:Name="Grid" RowDefinitions="50, *" ColumnDefinitions="*, 50">
		<StackPanel Background="AliceBlue" Orientation="Horizontal">
			<Label Content="Gas Type: "
				   Classes="bold"/>
			<ComboBox Classes=""
					  SelectedIndex="1" 
					  Height="30">
				<ComboBoxItem>Undefined</ComboBoxItem>
				<ComboBoxItem>O2</ComboBoxItem>
				<ComboBoxItem>N2</ComboBoxItem>
				<ComboBoxItem>Air</ComboBoxItem>
				<ComboBoxItem>O2LowerPressure</ComboBoxItem>
			</ComboBox>

			<Label Content="Contour Select: "
				   Classes="bold"/>
			<ComboBox Classes=""
					  SelectedIndex="0" 
					  Height="30">
				<ComboBoxItem>All contour</ComboBoxItem>
				<ComboBoxItem>Large</ComboBoxItem>
				<ComboBoxItem>Medium</ComboBoxItem>
				<ComboBoxItem>Small</ComboBoxItem>
			</ComboBox>
		</StackPanel>
		<TabControl x:Name="TabControl" Margin="5"
					Grid.Row="1"
					TabStripPlacement="Left">
			<TabItem Header="Large"/>
			<TabItem Header="Medium"/>
			<TabItem Header="Small"/>
			<TabItem Header="Special"/>
			<TabItem Header="Prehole"/>
		</TabControl>
		<Panel Background="Blue" 
			   Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"/>
	</Grid>
</base:Panel>
